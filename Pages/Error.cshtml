@page
@model ErrorModel

@{
    ViewData["Title"] = "Something Went Wrong";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/error.css"
          asp-append-version="true" />
}

<main class="error-page">

    
    <!-- =====================================================
         BACKGROUND
         ===================================================== -->

    <div class="error-background"
         aria-hidden="true">
    </div>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="error-header">

        <a class="error-brand"
           asp-page="/Index"
           aria-label="Vishwajeet Joshi home">

            Vishwajeet

        </a>


        <div class="error-header-meta">

            <span>ERROR</span>

            <span>500</span>

        </div>

    </header>


    <!-- =====================================================
         ERROR CONTENT
         ===================================================== -->

    <section class="error-content">

        <div class="error-index">
            ERROR / Something Went Wrong
        </div>


        <h1 class="error-title">

            Something
            <em>went wrong.</em>

        </h1>


        <p class="error-description">

            We encountered an unexpected problem while
            processing your request. Please return home
            and try again.

        </p>


        <!-- =================================================
             ACTIONS
             ================================================= -->

        <div class="error-actions">

            <a asp-page="/Index"
               class="error-primary-link">

                Return Home →

            </a>


            <a asp-page="/About"
               class="error-secondary-link">

                Explore About

            </a>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="error-footer">

        <span>
            Vishwajeet Joshi
        </span>

        <span>
            Data • Regulatory Technology • AI
        </span>

    </footer>
    

</main>
