@page
@model StudioModel

@{
    ViewData["Title"] = "Studio";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/studio.css"
          asp-append-version="true" />
}

<main class="studio-page">


    <!-- =====================================================
         BACKGROUND
         ===================================================== -->

