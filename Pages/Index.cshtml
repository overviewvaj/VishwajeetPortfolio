@page
@model IndexModel

@{
    ViewData["Title"] = "Vishwajeet Joshi";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
}

<main class="home-page"
      id="home">

    <!-- =====================================================
         CINEMATIC VIDEO BACKGROUND
         ===================================================== -->

    <div class="home-video-layer"
         aria-hidden="true">

        <video id="heroVideo"
            
   class="hero-video"
               muted
               playsinline
               preload="auto">

           <!-- <source src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260328_083109_283f3553-e28f-428b-a723-d639c617eb2b.mp4"
                    type="video/mp4" />  -->  <!-- commented out as the video can be used from the folders -->
            <source src="~/videos/video2.mp4"
                    type="video/mp4" />

        </video>
        <div class="video-overlay"></div>

    </div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <header class="home-header">

        <!-- BRAND -->

        <a class="site-brand"
           href="/"
           aria-label="Vishwajeet Joshi home">

            Vishwajeet Joshi

        </a>


        <!-- DESKTOP NAVIGATION -->

        <nav class="desktop-nav"
             aria-label="Primary navigation">

            <a href="#home"
               class="active">

                Home

            </a>

            <a href="/Studio">

                Studio

            </a>

            <a href="/About">

                About

            </a>

            <a href="/Journal">

                Journal

            </a>

            <a href="/ReachUs">

                Reach Us

            </a>

        </nav>


        <!-- DESKTOP CTA -->

        <a class="header-cta"
           href="/ReachUs">

            Begin Journey

        </a>


        <!-- MOBILE MENU -->

        <button class="mobile-menu-button"
                id="mobileMenuButton"
                type="button"
                aria-label="Open navigation"
                aria-expanded="false"
                aria-controls="mobileDrawer">

            <span></span>
            <span></span>
            <span></span>

        </button>

    </header>


    <!-- =====================================================
         HERO CONTENT
         ===================================================== -->

    <section class="home-hero"
             aria-labelledby="hero-heading">

        <div class="hero-content">

            <!-- EYEBROW -->

            <p class="hero-eyebrow">
                Data • Analytics • Regulatory Technology • AI
            </p>


            <!-- MAIN HOOK -->

            <h1 id="hero-heading"
                class="hero-heading">

                Beyond
                <em>data,</em>
                we build
                <em>systems</em>
                that matter.

            </h1>


            <!-- DESCRIPTION -->

            <p class="hero-description">

                Building intelligent data platforms, regulatory
                technology, and AI-driven solutions where complex
                information becomes clear, actionable decisions.

            </p>


            <!-- HERO CTA -->

            <a class="hero-cta"
               href="/About">

                Begin Journey

            </a>

        </div>


        <!-- =================================================
             HERO META
             ================================================= -->

        <div class="hero-meta">

            <div class="hero-meta-left">

                <span>
                    London / India
                </span>

                <span>
                    Data &amp; Regulatory Technology
                </span>

            </div>


            <div class="hero-meta-right">

                <span>
                    Scroll to explore
                </span>

                <span class="scroll-arrow"
                      aria-hidden="true">

                    ↓

                </span>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MOBILE DRAWER
         ===================================================== -->

    <aside class="mobile-drawer"
           id="mobileDrawer"
           aria-hidden="true">

        <div class="mobile-drawer-content">


            <!-- CLOSE -->

            <button class="mobile-close"
                    id="mobileClose"
                    type="button"
                    aria-label="Close navigation">

                <span></span>
                <span></span>

            </button>


            <!-- MOBILE BRAND -->

            <div class="mobile-drawer-brand">

                Vishwajeet Joshi

            </div>


            <!-- MOBILE NAVIGATION -->

            <nav class="mobile-nav"
                 aria-label="Mobile navigation">

                <a href="#home">
                    Home
                </a>

                <a href="/Studio">
                    Studio
                </a>

                <a href="/About">
                    About
                </a>

                <a href="/Journal">
                    Journal
                </a>

                <a href="/ReachUs">
                    Reach Us
                </a>

            </nav>


            <!-- PROFESSIONAL LINKS -->

            <div class="mobile-links">

                <span class="mobile-links-label">
                    Connect
                </span>


                <a href="https://www.linkedin.com/in/vishwajeet--joshi/"
                   target="_blank"
                   rel="noopener noreferrer">

                    LinkedIn

                </a>


                <a href="https://github.com/overviewvaj"
                   target="_blank"
                   rel="noopener noreferrer">

                    GitHub

                </a>


                <a href="https://medium.com/@@vishwajeetjoshi6"
                   target="_blank"
                   rel="noopener noreferrer">

                    Medium

                </a>

            </div>

        </div>

    </aside>

</main>